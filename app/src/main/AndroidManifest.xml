<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.chico.kiritoprojects">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.INTERNET"/>

    <uses-sdk
        android:targetSdkVersion="33"
        android:minSdkVersion="16"
        tools:overrideLibrary="androidx.appcompat.appcompat_resource"
        tools:ignore="GradleOverrides" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic2_foreground"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic2_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KiritoProjects"
        tools:targetApi="s">

        <activity
            android:name="com.chico.kiritoprojects.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KiritoProjects"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
